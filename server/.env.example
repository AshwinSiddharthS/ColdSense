# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/cold-chain
# Atlas:  mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/cold-chain
# If MongoDB is unavailable during local development, backend falls back to local disk persistence (data/readings.json)
MONGO_URI=mongodb://127.0.0.1:27017/cold-chain

# ── JWT (Web Users) ───────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# ── Device Authentication (ESP32) ─────────────────────
# When DEVICE_AUTH_ENABLED=true or DEVICE_AUTH_TOKEN is non-empty,
# the ESP32 must supply this exact token in the X-Device-Token header.
DEVICE_AUTH_ENABLED=false
DEVICE_AUTH_TOKEN=your_secure_device_secret_token_here

# ── Ingestion Rate Limiting ───────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ── CORS ──────────────────────────────────────────────
# In production, specify comma-separated allowed origin(s), e.g. https://coldchain.example.com
CLIENT_ORIGIN=http://localhost:5173
